# Git & version control
.git
.gitignore
.gitattributes

# Dependencies (prevent host node_modules from overwriting container npm ci)
node_modules/

# Build artifacts & local caches
dist/
dist-ssr/
*.local
.cache/
.parcel-cache/

# Secrets and local environment configs (preserve example templates)
.env
.env.*
!.env.example

# Test caches, reports, and coverage
coverage/
.vitest/
*.lcov

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentation & IDE
*.md
.idea/
.vscode/
*.swp
*.swo
.DS_Store
