# Dependencies (prevents overwriting npm ci in container & saves 1.3GB context)
node_modules/

# Production build output
dist/

# Environment files (prevent baking secrets into static assets)
.env
.env.*
!.env.example

# Testing & Coverage
coverage/
.vitest/

# Git & Repository metadata
.git/
.gitignore

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
