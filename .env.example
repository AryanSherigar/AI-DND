# ==============================================================================
# AI-DND Local Docker & Environment Configuration Template
# Copy this file to .env before starting Docker Compose services:
#   cp .env.example .env
#
# NOTE: The credentials below (e.g. POSTGRES_PASSWORD, SECRET_KEY) are default
# placeholders intended ONLY for isolated local development.
# DO NOT use these default values in staging or production environments!
# ==============================================================================

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aidnd_db
POSTGRES_PORT=5432

# --- Core API Configuration ---
CORE_API_PORT=8000
CORE_API_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aidnd_db
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CREDENTIALS_PATH=
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
ENVIRONMENT=development
LOG_LEVEL=INFO
GCS_BUCKET_NAME=your_gcs_bucket_name_here
CORE_API_PUBLIC_URL=http://localhost:8000

# --- Turn Resolution Service Configuration ---
TRS_PORT=8001
TRS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aidnd_db
# Get a key at https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your_gemini_api_key_here
MEMORY_SERVICE_URL=http://localhost:8002
# Sent as `Authorization: Bearer <key>` to the memory layer. core-api,
# turn-resolution-service, and memory-layer (as CONTEXT_MEMORY_API_KEY) all
# read this single variable -- there is no separate MEMORY_LAYER_API_KEY.
MEMORY_SERVICE_API_KEY=dev-memory-layer-key-change-in-production
LOG_LEVEL=INFO

# --- Memory Layer Configuration ---
# mem1: the graph-backed long-term memory service (apps/memory-layer). Own
# Postgres database and HydraDB graph store, kept separate from aidnd_db --
# unrelated schema, migrated independently.
MEMORY_LAYER_PORT=8002
MEMORY_LAYER_DATABASE_URL=postgresql://context_memory:context_memory@postgres-memory:5432/context_memory
HYDRADB_URL=http://hydradb:8080
HYDRADB_API_KEY=context-memory-local-smoke-token-32b
HYDRADB_GRAPH_ID=default
# Pins the prebuilt ghcr.io/hydra-db/hydradb image tag used by docker-compose.yml
# and apps/memory-layer/compose.yaml. Override to test a different upstream build.
HYDRADB_IMAGE_TAG=sha-02a4002
# Vertex AI (Gemini) key for the memory layer's own extraction/retrieval LLM
# calls -- independent of TRS's GEMINI_API_KEY above (separate service,
# separate quota), though both may point at the same Google Cloud project.
# Get a key at https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_CLOUD_API_KEY=your_gemini_api_key_here

# --- Frontend Configuration ---
FRONTEND_PORT=5173
# Baked into the production build as the base URL the frontend calls for the
# API and for TRS. Defaults to same-origin paths routed by the frontend's own
# nginx reverse proxy (see apps/frontend/nginx.conf) -- do NOT set these to an
# absolute http://localhost URL, that value gets compiled into the bundle
# and breaks every deployment except your own machine (see docker-compose.yml
# CRIT-01). Local dev (docker-compose.dev.yml) hardcodes its own absolute
# localhost URLs directly and ignores these two.
VITE_CORE_API_URL=/api
VITE_TRS_URL=/trs
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_MEASUREMENT_ID=your_measurement_id_here
